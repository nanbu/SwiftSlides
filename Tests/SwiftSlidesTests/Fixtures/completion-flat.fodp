<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:mimetype="application/vnd.oasis.opendocument.presentation" office:version="1.3">
<office:automatic-styles><style:page-layout style:name="L1"><style:page-layout-properties fo:page-width="100pt" fo:page-height="80pt"/></style:page-layout><style:page-layout style:name="L2"><style:page-layout-properties fo:page-width="200pt" fo:page-height="150pt"/></style:page-layout></office:automatic-styles>
<office:master-styles><style:master-page style:name="M1" style:page-layout-name="L1"/><style:master-page style:name="M2" style:page-layout-name="L2"/></office:master-styles>
<office:body><office:presentation><draw:page draw:name="One" draw:master-page-name="M1"><draw:rect svg:width="20pt" svg:height="10pt"><text:p>Fictional</text:p></draw:rect></draw:page><draw:page draw:name="Two" draw:master-page-name="M2"/></office:presentation></office:body></office:document>
